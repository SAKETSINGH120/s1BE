# Copy to .env in this folder (server/.env). Variables set in the real environment win.

# --- Server ---
# development (default), test or production. Production enables Secure cookies and requires SMTP.
# NODE_ENV=development
PORT=4000
# Origin allowed by CORS; also the base URL used in password reset links.
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://saketsingh186_db_user:qtT9fyxhpqTV1CQ8@cluster0.3pv8bab.mongodb.net/s1
# Number of reverse proxies in front of the API (0 when exposed directly).
TRUST_PROXY=0

# --- Auth ---
# Required. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Required. 32 random bytes as base64; encrypts secret environment values at rest.
# Keep it safe: changing or losing it makes stored secrets unreadable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=
SESSION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30

# --- Request execution ---
EXECUTION_TIMEOUT_MS=30000
EXECUTION_MAX_RESPONSE_BYTES=10485760
EXECUTION_MAX_REDIRECTS=5
# Self-hosting only: allow requests to localhost/private networks. Never enable on a shared deployment.
EXECUTION_ALLOW_PRIVATE_NETWORKS=false

# --- History ---
# Entries kept per workspace, and days before entries expire.
HISTORY_MAX_ENTRIES=100
HISTORY_RETENTION_DAYS=30

# --- Email (required in production; in development emails are printed to the server console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
